1:["$","main",null,{"id":"main","className":"home-page","children":[["$","div",null,{"className":"home-progress","aria-hidden":"true"}],["$","$Lf",null,{}],["$","div",null,{"className":"hero-stage","children":["$","section",null,{"className":"hero container","id":"home","aria-labelledby":"name","children":[["$","div",null,{"className":"hero-copy","children":[["$","p",null,{"className":"eyebrow","children":"天津大学 · 管理科学与工程"}],["$","div",null,{"className":"hero-name","children":[["$","h2",null,{"id":"name","aria-label":"杨礼铭","children":[["$","span","0",{"className":"name-glyph","aria-hidden":"true","style":{"animationDelay":"0ms"},"children":"杨"}],["$","span","1",{"className":"name-glyph","aria-hidden":"true","style":{"animationDelay":"90ms"},"children":"礼"}],["$","span","2",{"className":"name-glyph","aria-hidden":"true","style":{"animationDelay":"180ms"},"children":"铭"}]]}],["$","span",null,{"className":"english-name","children":"Liming Yang"}]]}],["$","p",null,{"className":"hero-degree","children":"博士研究生 · 预计 2027 年毕业"}],["$","p",null,{"className":"hero-position","children":"运筹优化与算法研究"}],["$","p",null,{"className":"hero-description","children":"关注生产与供应链中的复杂决策，结合数学建模、精确算法与启发式方法，研究资源配置和协同调度。"}],["$","div",null,{"className":"hero-actions","children":["$","a",null,{"className":"text-link","href":"mailto:tjulimingyang@163.com","children":["联系我 ",["$","$L10",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16,"aria-hidden":"true"}]]}]}]]}],["$","div",null,{"className":"hero-portrait","children":["$","img",null,{"className":"portrait","src":"/portrait.jpg","alt":"杨礼铭的个人照片","width":"800","height":"1120","fetchPriority":"high"}]}]]}]}],["$","section",null,{"className":"container","id":"projects","aria-labelledby":"projects-title","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"projects-title","children":"代表项目"}],["$","a",null,{"className":"text-link","href":"/projects","children":["全部项目 ",["$","$L10",null,{"ref":"$undefined","iconNode":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"m12 5 7 7-7 7","key":"xquz4c"}]],"className":"lucide-arrow-right","size":16,"aria-hidden":"true"}]]}]]}],["$","$L11",null,{"projects":[{"id":"production","category":"新型生产组织 · Seru / 协作机器人","displayTitle":["资源配置与","协同调度优化"],"title":"新型生产组织模式下的资源配置与协同调度优化","role":"两个子课题均独立完成建模与算法研究","topics":[{"title":"多能工配置与 Seru 调度","summary":"联合优化多能工分配、工序指派与产品排序。","status":"JMSE · 已发表 · 第一作者","text":"在技能覆盖与工序优先约束下，联合优化工人与产品分配、工序指派和产品排序。采用限时 MILP 分配与模拟退火排序的两阶段算法。","note":"论文共测试 864 个算例；大规模组平均求解时间为 86.87 秒，MILP + Gurobi 为 1742.64 秒；大规模组平均 RPD 为 1.42%，MILP + Gurobi 为 6.14%。"},{"title":"协作机器人流水车间调度","summary":"联合决定机器人配置、处理模式与作业顺序。","status":"IJPE · 已投稿 · 导师第一作者，本人第二作者","text":"联合优化机器人配置、机器与机器人处理模式及作业排序；强化 MILP，并针对两机情形设计模拟退火与微型遗传嵌套算法。","note":"IJPE 已投稿 · 导师第一作者，本人第二作者。"}]},{"id":"additive","category":"多激光 / 可交换腔体","displayTitle":["复杂增材制造","系统调度优化"],"title":"复杂增材制造系统调度优化","role":"两个子课题均独立完成建模与算法研究","topics":[{"title":"烟雾干扰下的多激光协同调度","status":"拟投稿 IJPR · 导师第一作者，本人第二作者","text":"在烟雾干扰约束下，联合优化零件布局、激光分配与加工次序；构建强化 MILP，并设计贝叶斯引导的多邻域禁忌搜索，以缩短最大完工时间。","note":"拟投稿 IJPR · 导师第一作者，本人第二作者。"},{"title":"可交换腔体的无等待批调度","summary":"在三阶段无等待约束下，联合优化装批、构建单元分配与设备时序。","status":"拟投稿 IJPR · 导师第一作者，本人第二作者","text":"联合决定装批、构建单元分配与设备时序。针对单构建单元设计分支定界，进一步构造逻辑型 Benders 分解；并行系统的精确性受共享工作站数量条件限制。","note":"拟投稿 IJPR · 导师第一作者，本人第二作者。"}]},{"id":"lenovo","category":"联想 AI Lab · 科研实习","title":"企业级 MRP 优化","overview":{"summary":"面向多工厂物料计划，将多层 BOM、库存、采购、调拨、替代及采购批量规则统一为大规模 MILP。以 Python / Gurobi 实现 LP 松弛、取整调整与可行解热启动。","outcome":"1 项授权发明专利","context":"企业资源计划中的 MRP 计算方法，本人为第二发明人。科研实习为 2023.03–2023.04；专利 ZL 2023 1 1045755.9 于 2024.05 授权。"},"question":"将多层物料清单、调拨与替代规则，转化为可行的物料供需计划。","role":"独立完成 MRP 模型与算法实现","result":"1 项授权发明专利","resultContext":"企业资源计划中的 MRP 计算方法；本人为第二发明人。","topics":[{"title":"从业务规则到可行计划","text":"以 Python / Gurobi 构建大规模 MILP，纳入多层 BOM、库存、采购、跨工厂调拨、替代与最小采购量约束。以 LP 松弛下界及取整调整构造可行解，并作为求解器初始解。","note":"科研实习：2023.03–2023.04。专利 ZL 2023 1 1045755.9，于 2024.05 授权。"}]},{"id":"nio","category":"蔚来 · 产学研项目","title":"新能源汽车跨三链协同优化","overview":{"summary":"多次赴蔚来访谈业务与技术团队，参与图结构化跨三链网络模型，衔接订单、供应与产能。负责四阶段词典序 MILP、资源约束诊断及 KPI 归因、预警框架的总体设计。","outcome":"确认订单 → 净预测需求 → 利润 → 成本","context":"按业务优先级组织决策，进一步定位资源缺口。自 2026.01 起参与，目前基于小规模合成实验验证。"},"question":"连接生产、供应与价值链，协调订单、产能和经营目标。","role":"核心参与，负责业务抽象与总体算法框架设计","result":"四阶段词典序规划","resultContext":"按订单、预测需求、利润与成本组织决策，并诊断资源缺口。","topics":[{"title":"图结构化表示与分层决策","text":"多次赴蔚来访谈业务与技术团队，参与图结构化跨三链网络模型；负责四阶段词典序 MILP、资源约束诊断，以及 KPI 归因与预警框架的总体设计。","note":"2026.01 至今 · 天津大学方核心参与。当前验证基于小规模合成实验。"}]},{"id":"delivery","category":"工业工程与精益管理创新赛 · 2026","title":"社区末端配送优化","overview":{"summary":"面向 AOI 需求簇，联合建模订单分配、车辆路径与人车接驳，以履约、时效和成本作为分层目标。辅助设计图卷积网络增强的自适应大邻域搜索，协调快递员服务与车辆补给。","outcome":"订单履约率约 89% → 约 99%","context":"团队方案基于真实网点地理信息的仿真，对比传统返仓补货模式。获华北赛区一等奖，晋级全国总决赛。"},"question":"联合优化订单分配、车辆路径与人车接驳，减少返仓补货。","role":"独立建模、PPT 制作与汇报；辅助算法设计","result":"约 89% → 约 99%","resultContext":"团队协同配送方案的仿真订单履约率，基于真实网点地理信息。","topics":[{"title":"面向 AOI 需求簇的动态优化","text":"独立建立按履约、时效与成本排序的词典序混合整数规划模型，辅助设计图卷积网络增强的自适应大邻域搜索算法。","note":"华北赛区一等奖，晋级全国总决赛。比较基线为传统返仓补货模式，结果来自仿真实验。"}]}]}]]}],"$L12","$L13"]}]
