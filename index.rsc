13:["$","section",null,{"className":"about-band","id":"about","aria-labelledby":"about-title","children":["$","div",null,{"className":"container about-inner","children":[["$","div",null,{"children":[["$","h2",null,{"id":"about-title","children":"关于我"}],["$","p",null,{"className":"about-copy","children":"就读于天津大学管理科学与工程专业，研究方向为运筹优化。围绕制造与供应链中的资源配置、生产调度和计划协同，将业务需求与现场约束转化为数学模型，开展算法设计、实现与实验验证。研究工作兼顾求解质量、计算效率和业务可解释性。"}],["$","p",null,{"className":"about-skills","children":"Python / Gurobi · 数学规划 · 精确算法 · 启发式算法"}],["$","a",null,{"className":"text-link about-link","href":"/about","children":["更多关于我 ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1:props:children:3:props:children:0:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","size":16,"aria-hidden":"true"}]]}]]}],["$","$L14",null,{}]]}]}]
