1:["$","main",null,{"id":"main","className":"container inner-page project-page","children":[["$","a",null,{"className":"text-link back-link","href":"/projects","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":15,"aria-hidden":"true"}]," 全部项目"]}],["$","header",null,{"className":"page-heading","children":[["$","h1",null,{"aria-label":"新能源汽车跨三链协同优化","children":"新能源汽车跨三链协同优化"}],["$","p",null,{"className":"page-intro","children":"围绕新能源汽车大规模定制下的 S&OP，研究生产链、供应链与价值链之间的统一表示和有优先级的协同决策。"}]]}],["$","div",null,{"className":"detail-layout","children":[false,["$","div",null,{"className":"studies","children":[["$","section","tri-chain",{"id":"tri-chain","className":"study","aria-labelledby":"tri-chain-title","children":[["$","h2",null,{"id":"tri-chain-title","className":"study-title","children":[false,"跨三链表示与词典序规划"]}],["$","div",null,{"className":"prose study-opening","children":[["$","p",null,{"children":"订单、产能、物料与经营目标分散在不同数据和决策口径中。跨链实体需要统一识别，候选方案也需要明确的目标优先级及资源缺口追溯。"}],["$","p",null,{"className":"study-contribution","children":[["$","strong",null,{"children":"我的工作"}]," ","作为天津大学方核心参与者，多次赴蔚来访谈业务与技术团队；负责业务问题抽象及总体算法框架设计。"]}]]}],["$","$L10",null,{}],["$","$L11",null,{"id":"tri-chain","data":{"title":"经济参数变化时，订单优先级是否稳定","source":"跨三链协同优化研究稿 Tables 2–3、§V.B、Fig. 3；SOP-E1 经济尺度对比记录。","protocol":"采用合成数据分别验证网络表达与协同决策。网络实验覆盖 1、10、50、100、500 单的高、低共享场景，并检验结构校验、粒度投影和语义查询。决策实验中，8 单确认需求与 8 单净预测需求竞争只能支撑 10 辆的共享资源；收入与全部可控成本同步乘以 0.1、1、10，固定权重及归一化基准不变，比较词典序与三种固定权重模型。12 组求解结果均已证明最优。","takeaway":"三个经济尺度下，词典序方案始终满足全部确认订单和 25% 的净预测需求。9 组固定权重组合中有 4 组转为确认订单满足 25%、净预测满足 100%：经济优先权重在 ×1 时发生切换，三种权重在 ×10 时均切换。资源总量没有变化，变化的是有限资源的分配顺序。将服务目标按顺序求优并固定，可在本组尺度扰动中保持既定业务优先级；固定权重的结果则取决于权重、经济项量级与归一化基准的共同作用。","metrics":[{"label":"确认订单满足率","unit":"%","direction":"既定第一优先级","decimals":0},{"label":"净预测需求满足率","unit":"%","direction":"既定第二优先级","decimals":0}],"groups":[{"label":"经济尺度 ×0.1","rows":[{"name":"词典序","values":[100,25],"featured":true},{"name":"服务权重","values":[100,25]},{"name":"均衡权重","values":[100,25]},{"name":"经济权重","values":[100,25]}]},{"label":"经济尺度 ×1","rows":[{"name":"词典序","values":[100,25],"featured":true},{"name":"服务权重","values":[100,25]},{"name":"均衡权重","values":[100,25]},{"name":"经济权重","values":[25,100]}]},{"label":"经济尺度 ×10","rows":[{"name":"词典序","values":[100,25],"featured":true},{"name":"服务权重","values":[25,100]},{"name":"均衡权重","values":[25,100]},{"name":"经济权重","values":[25,100]}]}]},"title":"$undefined","children":false}],false,false,[false,false]]}]]}]]}],["$","div",null,{"className":"page-bottom","children":[["$","a",null,{"className":"text-link","href":"/projects","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:0:props:children:0:props:iconNode","className":"lucide-arrow-left","size":16,"aria-hidden":"true"}]," 返回全部项目"]}],["$","a",null,{"className":"text-link","href":"/about","children":["关于我 ",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":16,"aria-hidden":"true"}]]}]]}]]}]
