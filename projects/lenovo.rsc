1:["$","main",null,{"id":"main","className":"container inner-page project-page","children":[["$","a",null,{"className":"text-link back-link","href":"/projects","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":15,"aria-hidden":"true"}]," 全部项目"]}],["$","header",null,{"className":"page-heading","children":[["$","h1",null,{"aria-label":"企业级 MRP 优化","children":"企业级 MRP 优化"}],["$","p",null,{"className":"page-intro","children":"将多层物料关系与采购业务规则转化为可计算的计划模型，处理大规模 MRP 的可行解构造与求解效率问题。"}]]}],["$","div",null,{"className":"detail-layout","children":[false,["$","div",null,{"className":"studies","children":[["$","section","mrp",{"id":"mrp","className":"study","aria-labelledby":"mrp-title","children":[["$","h2",null,{"id":"mrp-title","className":"study-title","children":[false,"从物料关系到可执行计划"]}],["$","div",null,{"className":"prose study-opening","children":[["$","p",null,{"children":"企业 MRP 同时涉及多层 BOM、库存、已下达采购订单、跨工厂调拨与物料替代。最小采购量和包装倍数等规则使供需平衡具有大规模离散决策结构。"}],["$","p",null,{"className":"study-contribution","children":[["$","strong",null,{"children":"我的工作"}]," ","在联想 AI Lab 科研实习期间，独立完成 Python / Gurobi 模型、可行解构造算法及计算实现。"]}]]}],["$","$L10",null,{}],["$","$L11",null,{"id":"mrp","data":{"title":"11 个历史算例的求解记录","source":"MRP 实验记录，Sheet1 (2)，B4:I14；2026-09-07 按共同下界重新核算。","protocol":"同一算例的两种方案均以记录中的 Gurobi 下界 LB 为参考，偏差 = (目标值 − LB) / |LB| × 100%。此口径不同于求解器自身的 MIP gap。时间为求解阶段记录，未包含全部数据预处理；Gurobi 限时 1800 秒。11 例为历史记录，不是多次重复实验均值。","takeaway":"算例 01–02 直接求解更快，且两种方案均达到下界；算例 03–04 直接求解的偏差较低，05–11 启发式在更短时间内取得更好的目标值。页面只展示相对指标与时间。","metrics":[{"label":"相对共同下界偏差","unit":"%","direction":"越低越好","decimals":4},{"label":"求解阶段耗时","unit":"秒","direction":"越低越好","decimals":0}],"groups":[{"label":"算例 01","rows":[{"name":"Gurobi","values":[0,4]},{"name":"松弛 + 启发式","values":[0,10],"featured":true}]},{"label":"算例 02","rows":[{"name":"Gurobi","values":[0,4]},{"name":"松弛 + 启发式","values":[0,9],"featured":true}]},{"label":"算例 03","rows":[{"name":"Gurobi","values":[0.0318,1800]},{"name":"松弛 + 启发式","values":[0.3035,10],"featured":true}]},{"label":"算例 04","rows":[{"name":"Gurobi","values":[0.1129,1800]},{"name":"松弛 + 启发式","values":[0.3875,21],"featured":true}]},{"label":"算例 05","rows":[{"name":"Gurobi","values":[0.8361,1800]},{"name":"松弛 + 启发式","values":[0.085,22],"featured":true}]},{"label":"算例 06","rows":[{"name":"Gurobi","values":[4.8995,1800]},{"name":"松弛 + 启发式","values":[0.6413,36],"featured":true}]},{"label":"算例 07","rows":[{"name":"Gurobi","values":[5.2399,1800]},{"name":"松弛 + 启发式","values":[0.8308,36],"featured":true}]},{"label":"算例 08","rows":[{"name":"Gurobi","values":[7.3789,1800]},{"name":"松弛 + 启发式","values":[1.1288,32],"featured":true}]},{"label":"算例 09","rows":[{"name":"Gurobi","values":[7.3916,1800]},{"name":"松弛 + 启发式","values":[0.9805,36],"featured":true}]},{"label":"算例 10","rows":[{"name":"Gurobi","values":[11.2754,1800]},{"name":"松弛 + 启发式","values":[1.8705,29],"featured":true}]},{"label":"算例 11","rows":[{"name":"Gurobi","values":[12.7228,1800]},{"name":"松弛 + 启发式","values":[2.8367,31],"featured":true}]}]},"title":"求解方法与结果","children":["$","p",null,{"id":"mrp-method","className":"mrp-method-summary","children":[["$","strong",null,{"children":"求解方法"}],"先用 LP 松弛确定供应、调拨与替代的整体计划，再按工厂、物料和时间顺序恢复 MPQ 整数采购批次，将取整余量留给后续需求，减少重复采购。核对 MOQ、MPQ 与供需平衡后，将完整可行解作为 Gurobi 的热启动；LP 下界与可行目标值用于评估方案质量。"]}]}],false,false,[false,["$","div",null,{"className":"related-links","children":[["$","a","/publications#mrp-patent",{"className":"text-link","href":"/publications#mrp-patent","children":["物料需求计划授权专利",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":15,"aria-hidden":"true"}]]}]]}]]]}]]}]]}],["$","div",null,{"className":"page-bottom","children":[["$","a",null,{"className":"text-link","href":"/projects","children":[["$","$Lf",null,{"ref":"$