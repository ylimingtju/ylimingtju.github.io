3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"项目 · 杨礼铭"}],["$","meta","1",{"name":"description","content":"天津大学管理科学与工程博士研究生杨礼铭的个人作品集，涵盖生产调度、组合优化、精确算法及企业协同优化研究。"}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","link","3",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L7",null,{"fallback":"$8","children":["$","$L9",null,{"fallback":"$8","children":["$","$La",null,{"providerId":"layout:/","segmentMap":{"children":["projects"]},"children":["$","$Lb",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$Lc",null,{"resetKey":"projects","fallback":["$","main",null,{"id":"main","className":"container inner-page not-found","children":[["$","p",null,{"className":"eyebrow","children":"404"}],["$","h1",null,{"children":"页面未找到"}],["$","p",null,{"className":"page-intro","children":"该页面可能已移动，或链接地址有误。"}],["$","a",null,{"className":"text-link","href":"/projects","children":"浏览全部项目 →"}]]}],"children":["$","$Lc",null,{"resetKey":"[\"projects\"]","fallback":["$","main",null,{"id":"main","className":"container inner-page not-found","children":[["$","p",null,{"className":"eyebrow","children":"404"}],["$","h1",null,{"children":"页面未找到"}],["$","p",null,{"className":"page-intro","children":"该页面可能已移动，或链接地址有误。"}],["$","a",null,{"className":"text-link","href":"/projects","children":"浏览全部项目 →"}]]}],"children":["$","$Ld",null,{"children":["$","$Le",null,{"children":[["$","$La",null,{"providerId":"page:/projects","segmentMap":{"children":["__PAGE__"]},"children":["$","$Lb",null,{"id":"page:/projects"}]}],null]}]}]}]}]}]}]}]}],null,null]
