1:["$","main",null,{"id":"main","className":"container inner-page","children":[["$","header",null,{"className":"page-heading","children":[["$","p",null,{"className":"eyebrow","children":"研究与实践"}],["$","h1",null,{"children":"项目"}],["$","p",null,{"className":"page-intro","children":"从生产调度与精确算法，到企业业务建模与决策优化。"}]]}],["$","h2",null,{"className":"sr-only","children":"全部项目"}],["$","div",null,{"className":"project-list","children":[["$","$Lf","production",{"project":{"id":"production","category":"新型生产组织 · Seru / 协作机器人","displayTitle":["资源配置与","协同调度优化"],"title":"新型生产组织模式下的资源配置与协同调度优化","role":"两个子课题均独立完成建模与算法研究","topics":[{"title":"多能工配置与 Seru 调度","summary":"联合优化多能工分配、工序指派与产品排序。","status":"JMSE · 已发表 · 第一作者","text":"在技能覆盖与工序优先约束下，联合优化工人与产品分配、工序指派和产品排序。采用限时 MILP 分配与模拟退火排序的两阶段算法。","note":"论文共测试 864 个算例；大规模组平均求解时间为 86.87 秒，MILP + Gurobi 为 1742.64 秒；大规模组平均 RPD 为 1.42%，MILP + Gurobi 为 6.14%。"},{"title":"协作机器人流水车间调度","summary":"联合决定机器人配置、处理模式与作业顺序。","status":"IJPE · 已投稿 · 导师第一作者，本人第二作者","text":"联合优化机器人配置、机器与机器人处理模式及作业排序；强化 MILP，并针对两机情形设计模拟退火与微型遗传嵌套算法。","note":"IJPE 已投稿 · 导师第一作者，本人第二作者。"}]},"index":0}],["$","$Lf","additive",{"project":{"id":"additive","category":"多激光 / 可交换腔体","displayTitle":["复杂增材制造","系统调度优化"],"title":"复杂增材制造系统调度优化","role":"两个子课题均独立完成建模与算法研究","topics":[{"title":"烟雾干扰下的多激光协同调度","status":"拟投稿 IJPR · 导师第一作者，本人第二作者","text":"在烟雾干扰约束下，联合优化零件布局、激光分配与加工次序；构建强化 MILP，并设计贝叶斯引导的多邻域禁忌搜索，以缩短最大完工时间。","note":"拟投稿 IJPR · 导师第一作者，本人第二作者。"},{"title":"可交换腔体的无等待批调度","summary":"在三阶段无等待约束下，联合优化装批、构建单元分配与设备时序。","status":"拟投稿 IJPR · 导师第一作者，本人第二作者","text":"联合决定装批、构建单元分配与设备时序。针对单构建单元设计分支定界，进一步构造逻辑型 Benders 分解；并行系统的精确性受共享工作站数量条件限制。","note":"拟投稿 IJPR · 导师第一作者，本人第二作者。"}]},"index":1}],["$","$Lf","lenovo",{"project":{"id":"lenovo","category":"联想 AI Lab · 科研实习","title":"企业级 MRP 优化","overview":{"summary":"面向多工厂物料计划，将多层 BOM、库存、采购、调拨、替代及采购批量规则统一为大规模 MILP。以 Python / Gurobi 实现 LP 松弛、取整调整与可行解热启动。","outcome":"1 项授权发明专利","context":"企业资源计划中的 MRP 计算方法，本人为第二发明人。科研实习为 2023.03–2023.04；专利 ZL 2023 1 1045755.9 于 2024.05 授权。"},"question":"将多层物料清单、调拨与替代规则，转化为可行的物料供需计划。","role":"独立完成 MRP 模型与算法实现","result":"1 项授权发明专利","resultContext":"企业资源计划中的 MRP 计算方法；本人为第二发明人。","topics":[{"title":"从业务规则到可行计划","text":"以 Python / Gurobi 构建大规模 MILP，纳入多层 BOM、库存、采购、跨工厂调拨、替代与最小采购量约束。以 LP 松弛下界及取整调整构造可行解，并作为求解器初始解。","note":"科研实习：2023.03–2023.04。专利 ZL 2023 1 1045755.9，于 2024.05 授权。"}]},"index":2}],["$","$Lf","nio",{"project":{"id":"nio","category":"蔚来 · 产学研项目","title":"新能源汽车跨三链协同优化","overview":{"summary":"多次赴蔚来访谈业务与技术团队，参与图结构化跨三链网络模型，衔接订单、供应与产能。负责四阶段词典序 MILP、资源约束诊断及 KPI 归因、预警框架的总体设计。","outcome":"确认订单 → 净预测需求 → 利润 → 成本","context":"按业务优先级组织决策，进一步定位资源缺口。自 2026.01 起参与，目前基于小规模合成实验验证。"},"question":"连接生产、供应与价值链，协调订单、产能和经营目标。","role":"核心参与，负责业务抽象与总体算法框架设计","result":"四阶段词典序规划","resultContext":"按订单、预测需求、利润与成本组织决策，并诊断资源缺口。","topics":[{"title":"图结构化表示与分层决策","text":"多次赴蔚来访谈业务与技术团队，参与图结构化跨三链网络模型；负责四阶段词典序 MILP、资源约束诊断，以及 KPI 归因与预警框架的总体设计。","note":"2026.01 至今 · 天津大学方核心参与。当前验证基于小规模合成实验。"}]},"index":3}],["$","$Lf","delivery",{"project":{"id":"delivery","category":"工业工程与精益管理创新赛 · 2026","title":"社区末端配送优化","overview":{"summary":"面向 AOI 需求簇，联合建模订单分配、车辆路径与人车接驳，以履约、时效和成本作为分层目标。辅助设计图卷积网络增强的自适应大邻域搜索，协调快递员服务与车辆补给。","outcome":"订单履约率约 89% → 约 99%","context":"团队方案基于真实网点地理信息的仿真，对比传统返仓补货模式。获华北赛区一等奖，晋级全国总决赛。"},"question":"联合优化订单分配、车辆路径与人车接驳，减少返仓补货。","role":"独立建模、PPT 制作与汇报；辅助算法设计","result":"约 89% → 约 99%","resultContext":"团队协同配送方案的仿真订单履约率，基于真实网点地理信息。","topics":[{"title":"面向 AOI 需求簇的动态优化","text":"独立建立按履约、时效与成本排序的词典序混合整数规划模型，辅助设计图卷积网络增强的自适应大邻域搜索算法。","note":"华北赛区一等奖，晋级全国总决赛。比较基线为传统返仓补货模式，结果来自仿真实验。"}]},"index":4}],["$","$Lf","review-assignment",{"project":{"id":"review-assignment","category":"华为杯 · 2023","title":"大规模竞赛评审分配","overview":{"summary":"为 3,000 份作品与 125 名专家建立 MIQP，优化专家对共同评审数量的方差。采用作品中心编码与负载修复，结合遗传交叉和模拟退火交换，维护可行性并改善分配。","outcome":"专家对交集方差降低 11.08%","context":"来自完整规模算例，相较随机平均分配。作品《大规模创新类竞赛评审模型》获 2023 年华为杯国家级二等奖。"},"question":"为 3,000 份作品分配 125 名评审专家，平衡工作量与共同评审关系。","role":"完成问题建模，独立实现遗传–模拟退火混合算法","result":"国家级二等奖","resultContext":"作品：大规模创新类竞赛评审模型。","topics":[{"title":"大规模分配与可行性修复","text":"建立最小化专家对评审交集数量方差的 MIQP。采用作品中心编码与专家工作量修复，结合遗传交叉和模拟退火交换邻域搜索。","note":"完整规模算例中，专家对交集方差较随机平均分配降低 11.08%。"}]},"index":5}],"$L10","$L11","$L12"]}]]}]
10:["$","$Lf","core-loss",{"project":{"id":"core-loss","category":"华为杯 · 2024","title":"磁芯损耗的多目标优化","overview":{"summary":"在黑箱损耗预测模型下权衡磁芯损耗与传输磁能。枚举波形与材料组合，采用非支配排序人工蜂群算法搜索三个连续工况变量，再对汇总候选进行跨组合非支配筛选。","outcome":"国家级二等奖","context":"算法候选集对训练数据参考集的覆盖度为 100%，反向覆盖为 0%。这一比较针对两个有限解集；竞赛作品为《数据驱动下磁性元件的磁芯损耗建模》。"},"question":"在黑箱损耗预测模型下，权衡磁芯损耗与传输磁能。","role":"完成多目标建模，独立实现非支配排序人工蜂群算法","result":"国家级二等奖","resultContext":"作品：数据驱动下磁性元件的磁芯损耗建模。","topics":[{"title":"混合变量与非支配搜索","text":"枚举波形与材料组合，分别搜索三个连续变量构成的子问题，对汇总候选方案进行二次非支配筛选。","note":"相对训练数据中的已知非支配方案，算法解集实现 100% 覆盖且不被其反向覆盖。"}]},"index":6}]
11:["$","$Lf","field-research",{"project":{"id":"field-research","category":"长城 / 丰田 · 现场调研","title":"价值链协同需求分析","overview":{"summary":"结合长城、丰田现场调研及文献与行业案例，梳理纵向供应链与横向价值链中的资源、信息和业务协同关系，形成需求分析框架。","outcome":"覆盖产品全生命周期的五个环节","context":"研发、采购、制造、分销与售后。2023.09–2024.06 阶段性参与，成果为调研分析与结项报告。"},"question":"从企业现场与行业案例中，提炼产品全生命周期的协同需求。","role":"阶段性参与现场调研，负责结项报告核心章节","result":"覆盖产品全生命周期的五个环节","resultContext":"研发、采购、制造、分销与售后。","topics":[{"title":"从现场观察到需求框架","text":"赴长城汽车与丰田汽车现场调研，梳理纵向供应链与横向价值链中的资源、信息和业务协同关系，结合文献与行业案例形成需求分析框架。","note":"参与时间：2023.09–2024.06。成果为调研分析与报告。"}]},"index":7}]
12:["$","$Lf","llm-modeling",{"project":{"id":"llm-modeling","category":"探索性研究 · 2026","title":"LLM 辅助运筹优化建模","overview":{"summary":"以增材制造优化任务组织知识与测试样例，基于 ORLM 思路进行数据合成与去重，完成 Qwen3-8B 的 QLoRA 监督微调及基座模型对比。","outcome":"模型生成 → 语义审查 → 执行验证","context":"核对生成模型对原问题可行域与目标的表达，定位可行域偏差和求解状态误报。自 2026.03 起开展，当前为探索性研究。"},"question":"检验自然语言生成的优化模型，是否准确表达原问题的可行域与目标。","role":"开展轻量化复现、参数高效微调与建模验证","result":"模型生成、语义审查与执行验证","resultContext":"以增材制造优化任务组织知识与测试样例。","topics":[{"title":"建模数据与求解器联动","text":"基于 ORLM 思路开展数据合成与去重，完成 Qwen3-8B 的 QLoRA 监督微调及基座模型对比评估，分析可行域偏差与求解状态误报。","note":"2026.03 至今 · 探索性研究。"}]},"index":8}]
